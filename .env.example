# ============================================================
# MindPilot 配置示例
# 用法：复制本文件为 .env 并按需填写。.env 已被 .gitignore 忽略，
#       不会提交到仓库；请勿把真实 Key 写进本示例文件。
# ============================================================

# ---------- 一、AI 总结（可选能力） ----------
# 不配置 Key 时，下载 / 转写（字幕提取）完全不受影响，
# 仅 /api/summarize 会返回「未配置大模型」的友好提示。

# 选择大模型服务商（均走 OpenAI 兼容协议，可随时切换）：
#   deepseek / zhipu / qwen / kimi / openai
# 也接受别名：glm→zhipu、tongyi→qwen、moonshot→kimi、gpt→openai
LLM_MODEL_ID=deepseek

# 通用 API Key（优先级最高）。填了对应服务商的 Key 即可启用 AI 总结。
LLM_API_KEY=

# 也可改用各家专属变量名（与上面的 LLM_API_KEY 二选一，支持多个常见别名）：
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=      或 GLM_API_KEY=
# DASHSCOPE_API_KEY=  或 QWEN_API_KEY=
# MOONSHOT_API_KEY=   或 KIMI_API_KEY=
# OPENAI_API_KEY=

# 可选：覆盖默认模型 / 端点（一般无需填写）  LLM_MODEL / LLM_BASE_URL
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# 各服务商默认值（供参考）：
#   deepseek : https://api.deepseek.com/v1                        deepseek-chat
#   zhipu    : https://open.bigmodel.cn/api/paas/v4               glm-4-flash
#   qwen     : https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   kimi     : https://api.moonshot.cn/v1                         moonshot-v1-8k
#   openai   : https://api.openai.com/v1                          gpt-4o-mini

# 兼容说明：旧命名 LLM_MODEL_ID / LLM_API_KEY / LLM_MODEL / LLM_BASE_URL 仍会被识别，
#           但推荐使用上面的 AI_* 命名。

# ---------- 二、转写字幕 Cookie（可选） ----------
# B站等平台的语音字幕（CC / AI 字幕）需登录态才能获取；不配置时这类视频会
# 提示「未找到字幕」（YouTube 等无需登录即可取字幕的平台不受影响）。二选一即可：

# 方式一：cookies.txt 文件路径（Netscape 格式，可用浏览器插件 Get cookies.txt 导出）  COOKIE_FILE
# COOKIE_FILE=D:/path/to/cookies.txt

# 方式二：直接从本机浏览器读取登录态（chrome / edge / firefox / brave ...）  COOKIES_FROM_BROWSER
# 可选带用户配置目录，如 chrome:Profile 1
# COOKIES_FROM_BROWSER=chrome

# ---------- 三、语音识别 ASR 兜底（可选，强烈推荐） ----------
# 当视频抓不到字幕时（抖音无字幕轨、B站未登录等），自动下载音频调第三方语音识别转写。
# 不配置时：这类视频的转写 / AI 总结会返回明确提示（不影响本身有字幕的视频）。
# 配了多个则按「硅基流动 → DashScope」顺序自动尝试，前者失败/超限会自动切后者。

# 方式一（推荐·免费）：硅基流动 SenseVoiceSmall —— 免费不限量、中文强、国内直连、≤50MB  SILICONFLOW_API_KEY
#   到 https://cloud.siliconflow.cn 注册，拿 sk- 开头的 Key 填入即可
# SILICONFLOW_API_KEY=

# 方式二：阿里云百炼 Qwen3-ASR —— 可复用你已有的 DashScope Key（base64 编码后 ≤10MB）  DASHSCOPE_API_KEY
# DASHSCOPE_API_KEY=

# 可选：调整默认模型 / 强制尝试顺序 / 指定语种（一般无需填写）
# ASR_PROVIDER=siliconflow,dashscope
# SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# ASR_LANGUAGE=zh

# 或接入任意 OpenAI 兼容 /audio/transcriptions 端点（Groq / OpenAI / 自建）：
# ASR_API_KEY=
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_MODEL=whisper-large-v3-turbo

# ---------- 四、内容缓存 / 存储（可选，默认即开箱可用） ----------
# 转写与 AI 总结的结果会持久化缓存：同一视频再次操作直接「秒开」，且不再重复
# 消耗 ASR / 大模型额度。缓存为全局共享（不区分用户），因为转写/总结是可跨用户
# 复用的昂贵资产。默认用项目内 SQLite 文件，无需任何配置即可生效。

# 数据库连接串。阶段0 默认 SQLite；阶段1 迁 Postgres 只需改这一行：
#   postgresql+psycopg://user:pass@localhost:5432/mindpilot
# DATABASE_URL=sqlite:///./data/mindpilot.db

# 缓存总开关：设为 false 可临时关闭读写缓存（用于对照排障），默认 true
# CACHE_ENABLED=true

# 转写缓存有效期（天）：超过则视为未命中并重新转写；<=0 表示永不过期。默认 30
# TRANSCRIPT_CACHE_DAYS=30

# 说明：如需强制重算某个视频（忽略并覆盖缓存），前端请求可带 refresh=true。

# ---------- 五、多租户认证（可选，阶段A 地基） ----------
# 默认关闭：AUTH_ENABLED=false 时既有开放端点行为完全不变（仅 /api/auth/* 可用）。
# 开启且 AUTH_ALLOW_ANONYMOUS=false 时，业务端点（info/download/transcribe/summarize/
# mindmap/qa/comments）一律要求登录态，未登录返回 401，前端自动弹登录框；
# /api/health 与 /api/auth/* 始终开放。密码用 argon2id 哈希（未装 argon2-cffi 时自动
# 回退标准库 PBKDF2），会话为服务端可撤销的不透明令牌（DB 只存哈希）。

# AUTH_ENABLED=false          # 鉴权总开关（灰度）
# AUTH_ALLOW_ANONYMOUS=true   # true 时匿名仍可访问（走 IP 限流 + 免费额度）

# 会话 Cookie（生产建议 SESSION_COOKIE_SECURE=true，即仅 https 下发）
# SESSION_COOKIE_NAME=mp_sid
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax # lax / strict / none
# SESSION_COOKIE_PATH=/       # Cookie 作用路径（前后端下发/清除须一致）
# SESSION_TTL_HOURS=168       # 普通登录有效期（默认 7 天）
# REMEMBER_TTL_HOURS=720      # 勾选「记住我」的有效期（默认 30 天）

# 登录失败锁定（账号维度）与登录 IP 限流（抗撞库）
# LOGIN_MAX_ATTEMPTS=5        # 连续失败达此次数则临时锁定账号
# LOGIN_LOCKOUT_MINUTES=15    # 锁定时长（分钟）
# LOGIN_IP_MAX_PER_WINDOW=10  # 单 IP 在窗口内最多登录尝试次数
# LOGIN_IP_WINDOW_SECONDS=60  # 上述窗口长度（秒）

# 注册密码最小长度
# PASSWORD_MIN_LENGTH=8

# ---------- 六、登录标识符与个人资料（可选） ----------
# 登录/注册支持「邮箱 或 手机号」双通道：登录框含 @ 视为邮箱，否则按手机号处理；
# 注册时二者至少填一项（两项都填则均可用于登录）。手机号统一规范化为 E.164 存储
# （如 13800138000 / +86 138 0013 8000 / 0086-138-0013-8000 均归一为 +8613800138000）。
#
# 注意：当前版本**未接入短信服务商**，手机号仅做格式校验，phone_verified 恒为 false，
# 前端如实展示「未验证」；接入验证码后只需改 service.register / service.change_phone。

# PHONE_DEFAULT_REGION=CN     # 号码未带 + 国家码时补的默认区号（CN→86）
# NICKNAME_MAX_LENGTH=32      # 昵称长度上限（前端 maxlength 需同步）
# BIO_MAX_LENGTH=200          # 个性签名长度上限（前端 maxlength 需同步）

# 头像：本地落盘目录（相对路径按项目根解析；接对象存储时可指向同步目录）。
# 上传按**文件魔数**判定真实格式（不信 Content-Type），仅收 JPG/PNG/GIF/WEBP；
# SVG 被显式拒绝——它是 XML，可内嵌脚本，当图片渲染等于存储型 XSS。
# AVATAR_DIR=data/avatars
# AVATAR_MAX_BYTES=2097152    # 单张头像体积上限（默认 2MB）
